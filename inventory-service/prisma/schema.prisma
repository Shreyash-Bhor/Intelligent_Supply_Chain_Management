generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//User Model
model User {
  id       String @id @default(uuid())
  name     String @default("Customer")
  email    String @unique
  password String

  isEmailVerified Boolean @default(false)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  orders    Order[]
  cart      Cart?
  addresses Address[]
  assistantConversations AssistantConversation[]

  @@index([isActive])
}

model Warehouse {
  id      String @id @default(uuid())
  name    String @unique
  city    String
  pincode String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  inventories Inventory[]
}

model Inventory {
  id String @id @default(uuid())

  productId   String
  warehouseId String

  availableQty Int @default(0)
  reservedQty  Int @default(0)
  reorderQty   Int @default(0)

  isReorderPending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockReorders    StockReorder[]
  orderAllocations OrderAllocation[]

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([isReorderPending])
}

model StockReorder {
  id String @id @default(uuid())

  inventoryId  String
  requestedQty Int

  status ReorderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  orderId String? @unique

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([status])
}

enum ReorderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum Category {
  Electronics
  Grocery
  Beverages
  Fashion
  Fitness
  Stationery
  Sports
  Toys
}

model Product {
  id       String   @id @default(uuid())
  name     String
  sku      String   @unique
  imageUrl String?
  category Category @default(Electronics)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  inventories Inventory[]
  orders      Order[]
  orderItems  OrderItem[]

  @@index([isActive])
}

model ProductDeletion {
  id String @id @default(uuid())

  productId String
  reason    Reason @default(NO_LONGER_NEEDED)

  createdAt DateTime @default(now())

  @@index([productId])
}

enum Reason {
  OUT_OF_STOCK
  DEPRECATED
  NO_LONGER_NEEDED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  BACKORDERED
  CANCELLED
  FULFILLED
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id                 String        @id @default(uuid())
  userId             String
  productId          String
  quantity           Int
  allocatedQty       Int
  shortageQty        Int
  unitPrice          Decimal       @db.Decimal(10, 2)
  totalPrice         Decimal       @db.Decimal(12, 2)
  currency           String        @default("USD")
  status             OrderStatus
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now())
  idempotencyKey     String?
  checkoutDigest     String?
  paymentStatus      PaymentStatus @default(NOT_STARTED)
  paymentReference   String?
  subtotal           Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal      Decimal?      @db.Decimal(12, 2)
  taxTotal           Decimal?      @db.Decimal(12, 2)
  shippingName       String?
  shippingPhone      String?
  shippingAddress1   String?
  shippingAddress2   String?
  shippingCity       String?
  shippingRegion     String?
  shippingPostalCode String?
  shippingCountry    String?

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations  OrderAllocation[]
  stockReorder StockReorder?
  items        OrderItem[]
  shipments    Shipment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([productId])
  @@index([status])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  name       String
  phone      String
  address1   String
  address2   String?
  city       String
  region     String
  postalCode String
  country    String?
  idempotencyKey String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, idempotencyKey])
}

model AssistantConversation {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  messages       Json
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([expiresAt])
}

model AssistantRateLimit {
  bucketId    String
  windowStart DateTime
  hits        Int      @default(0)

  @@id([bucketId, windowStart])
  @@index([windowStart])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)
  allocatedQty Int      @default(0)
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String
  carrier        String?
  trackingNumber String?
  status         String    @default("UNFULFILLED")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
}

model OrderAllocation {
  id          String   @id @default(uuid())
  orderId     String
  inventoryId String
  quantity    Int
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@unique([orderId, inventoryId])
  @@index([inventoryId])
}
