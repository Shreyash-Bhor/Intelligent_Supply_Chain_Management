# Required service configuration
QDRANT_URL=https://your-qdrant-cluster.example
QDRANT_API_KEY=
COLLECTION_NAME=supply-chain-knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-secret
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=replace-with-supported-model
INVENTORY_SERVICE_URL=https://inventory.example
PRICING_SERVICE_URL=https://pricing.example
AUTH_TOKEN_SECRET=replace-with-shared-backend-secret

# Optional runtime tuning
PORT=8000
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=127.0.0.1
LLM_TEMPERATURE=0.2
RETRIEVAL_TOP_K=5
KNOWLEDGE_BASE_DIRECTORY=knowledge_base
MAX_AGENT_ITERATIONS=10
MAX_SHOPPING_AGENT_ITERATIONS=20
