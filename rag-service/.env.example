# Required service configuration
QDRANT_URL=https://your-qdrant-cluster.example
QDRANT_API_KEY=
COLLECTION_NAME=supply-chain-knowledge-cloudflare-bge-small-en-v1-5
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-api-token
EMBEDDING_BATCH_SIZE=100
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-secret
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=replace-with-supported-model
INVENTORY_SERVICE_URL=https://inventory.example
PRICING_SERVICE_URL=https://pricing.example
AUTH_TOKEN_SECRET=replace-with-shared-backend-secret

# Optional runtime tuning
PORT=8000
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=127.0.0.1
LLM_TEMPERATURE=0.2
RETRIEVAL_TOP_K=5
KNOWLEDGE_BASE_DIRECTORY=knowledge_base
MAX_AGENT_ITERATIONS=10
MAX_SHOPPING_AGENT_ITERATIONS=20
